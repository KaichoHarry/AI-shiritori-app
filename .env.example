# このファイルをコピーして .env を作成し、実際の値を設定する。
# .env は .gitignore 対象のためコミットされない。

# --- Database ---
DATABASE_URL=postgres://shiritori:shiritori@localhost:5432/shiritori?sslmode=disable

# --- JWT ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- Gemini API ---
GEMINI_API_KEY=

# --- 管理者承認フロー(パスワード再設定) ---
# 再設定申請の通知先。UIやコードに直書きせずここで管理する。
ADMIN_EMAIL=

# --- SMTP (メール送信: 管理者通知・新パスワード通知) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- IMAP (メール受信: 管理者の空メール返信の検知) ---
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_POLL_INTERVAL_SECONDS=30
